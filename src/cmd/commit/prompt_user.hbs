Generate a one-line Conventional Commit message based on this diff. Output ONLY the commit message text, no markdown, no quotes.

<summary>
{{#each files}}
{{status}} {{path}} +{{additions}} -{{deletions}}{{#if truncated}} (truncated){{/if}}
{{/each}}
</summary>

<diffs>
{{#each files}}
{{#if (eq kind "text")}}
<file path="{{path}}" type="text" total_lines="{{diff_size}}" truncated="{{truncated}}">
{{{details}}}
</file>
{{/if}}
{{#if (eq kind "binary")}}
<file path="{{path}}" type="binary" />
{{/if}}
{{#if (eq kind "skipped")}}
<file path="{{path}}" type="skipped" reason="{{reason}}" />
{{/if}}
{{/each}}
</diffs>
